# Metztli 2.0 — Variables de Entorno de Ejemplo
# Copia este archivo como .env en la carpeta frontend y completa los valores correspondientes.

# URL pública de tu instancia de Supabase (Cloud o Local)
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anónima de Supabase (segura para exponer en clientes móviles)
# NUNCA expongas la 'service_role' key en el frontend
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu_clave_anonima_publica_aqui
