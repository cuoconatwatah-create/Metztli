{
  "expo": {
    "name": "Metztli",
    "slug": "metztli",
    "version": "2.0.0",
    "icon": "./assets/icon.jpg",
    "splash": {
      "image": "./assets/icon.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#17153B"
    },
    "orientation": "portrait",
    "scheme": "metztli",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.metztli.app"
    },
    "android": {
      "package": "com.metztli.app",
      "permissions": [
        "android.permission.CALL_PHONE"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-localization"
    ]
  }
}
