{
  "expo": {
    "name": "Metztli",
    "slug": "metztli",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "metztli",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F1EA"
    },
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.metztli.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F4F1EA"
      },
      "package": "com.metztli.app",
      "permissions": [
        "android.permission.CALL_PHONE"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-localization"
    ]
  }
}
